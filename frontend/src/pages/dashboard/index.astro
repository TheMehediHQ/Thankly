---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Dashboard">
  <nav class="dash-nav">
    <div class="container dash-nav-inner">
      <a href="/dashboard" class="dash-logo">🌿 Thankly</a>
      <div class="dash-nav-links">
        <a href="/dashboard/journal">Journal</a>
        <a href="/dashboard/profile">Profile</a>
        <a href="/admin" id="admin-link" style="display: none;">Admin</a>
        <a href="#" id="logout-btn">Logout</a>
      </div>
    </div>
  </nav>

  <main class="container dash-main">
    <div class="dash-header">
      <h1>Today's Gratitudes</h1>
      <p id="today-date"></p>
    </div>

    <div class="entry-list" id="gratitude-list">
      <div class="entry-empty">
        <p>Loading...</p>
      </div>
    </div>

    <form id="gratitude-form" class="entry-form">
      <textarea
        id="gratitude-input"
        name="content"
        rows="3"
        maxlength="500"
        class="input"
        style="resize: none;"
        placeholder="I'm grateful for..."
      ></textarea>
      <div class="entry-form-footer">
        <span class="entry-count" id="remaining-count">3 remaining today</span>
        <button type="submit" id="submit-btn" class="btn btn-primary">Add Gratitude</button>
      </div>
    </form>
  </main>
</Layout>

<script>
  import { getToday, createGratitude, logout, isLoggedIn } from '../../lib/api';

  if (!isLoggedIn()) {
    window.location.href = '/login';
  }

  const user = JSON.parse(localStorage.getItem('user') || '{}');
  if (user.role === 'admin' || user.role === 'super_admin') {
    (document.getElementById('admin-link') as HTMLElement).style.display = 'inline';
  }

  const listEl = document.getElementById('gratitude-list') as HTMLDivElement;
  const form = document.getElementById('gratitude-form') as HTMLFormElement;
  const input = document.getElementById('gratitude-input') as HTMLTextAreaElement;
  const countEl = document.getElementById('remaining-count') as HTMLSpanElement;
  const dateEl = document.getElementById('today-date') as HTMLParagraphElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const logoutBtn = document.getElementById('logout-btn') as HTMLAnchorElement;

  logoutBtn.addEventListener('click', (e) => {
    e.preventDefault();
    logout();
  });

  const emojis = ['☀️', '❤️', '🚀', '🌿', '✨', '🙏', '🌸', '💫'];

  function renderEntries(data: any) {
    const entries = data.entries || [];
    const date = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    dateEl.textContent = date;

    if (entries.length === 0) {
      listEl.innerHTML = '<div class="entry-empty"><p>No entries yet today. Start writing below.</p></div>';
    } else {
      listEl.innerHTML = entries.map((e: any, i: number) => `
        <div class="entry-card">
          <span class="entry-emoji">${emojis[i % emojis.length]}</span>
          <span class="entry-text">${escapeHtml(e.content)}</span>
        </div>
      `).join('');
    }

    const remaining = 3 - entries.length;
    countEl.textContent = `${remaining} remaining today`;

    if (remaining <= 0) {
      input.disabled = true;
      submitBtn.disabled = true;
      input.placeholder = 'Daily limit reached. Come back tomorrow!';
    }
  }

  function escapeHtml(text: string) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  async function loadToday() {
    const data = await getToday();
    if (data) renderEntries(data);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const content = input.value.trim();
    if (!content) return;

    submitBtn.textContent = 'Adding...';
    submitBtn.style.opacity = '0.6';

    const result = await createGratitude(content);

    if (result?.ok) {
      input.value = '';
      await loadToday();
    } else {
      alert(result?.data?.error || 'Failed to add gratitude');
    }

    submitBtn.textContent = 'Add Gratitude';
    submitBtn.style.opacity = '1';
  });

  loadToday();
</script>

<style>
  .dash-nav {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .dash-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }
  .dash-logo {
    font-size: 20px;
    font-weight: 800;
    color: var(--green);
  }
  .dash-nav-links {
    display: flex;
    gap: 24px;
  }
  .dash-nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s;
  }
  .dash-nav-links a:hover { color: var(--text); }

  .dash-main {
    padding: 48px 0;
    max-width: 640px;
  }
  .dash-header {
    margin-bottom: 32px;
  }
  .dash-header h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-weight: 500;
  }
  .dash-header p {
    color: var(--muted);
    font-size: 15px;
    margin-top: 4px;
  }

  .entry-list {
    display: grid;
    gap: 12px;
    margin-bottom: 32px;
  }
  .entry-empty {
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    text-align: center;
  }
  .entry-empty p {
    color: var(--muted);
    font-style: italic;
  }
  .entry-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
  }
  .entry-emoji { font-size: 22px; }
  .entry-text { font-size: 15px; }

  .entry-form {
    display: grid;
    gap: 14px;
  }
  .entry-form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .entry-count {
    font-size: 13px;
    color: var(--muted);
  }
</style>
