---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Dashboard">
  <nav class="dash-nav">
    <div class="container dash-nav-inner">
      <a href="/dashboard" class="dash-logo">🌿 Thankly</a>
      <div class="dash-nav-links">
        <a href="/dashboard/journal">Journal</a>
        <a href="/dashboard/profile">Profile</a>
      </div>
    </div>
  </nav>

  <main class="container dash-main">
    <div class="dash-header">
      <h1>Today's Gratitudes</h1>
      <p>What are you grateful for today?</p>
    </div>

    <div class="entry-list" id="gratitude-list">
      <div class="entry-empty">
        <p>No entries yet today. Start writing below.</p>
      </div>
    </div>

    <form id="gratitude-form" class="entry-form">
      <textarea
        id="gratitude-input"
        name="content"
        rows="3"
        maxlength="500"
        class="input"
        style="resize: none;"
        placeholder="I'm grateful for..."
      ></textarea>
      <div class="entry-form-footer">
        <span class="entry-count" id="remaining-count">3 remaining today</span>
        <button type="submit" class="btn btn-primary">Add Gratitude</button>
      </div>
    </form>
  </main>
</Layout>

<style>
  .dash-nav {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .dash-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }
  .dash-logo {
    font-size: 20px;
    font-weight: 800;
    color: var(--green);
  }
  .dash-nav-links {
    display: flex;
    gap: 24px;
  }
  .dash-nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s;
  }
  .dash-nav-links a:hover { color: var(--text); }

  .dash-main {
    padding: 48px 0;
    max-width: 640px;
  }
  .dash-header {
    margin-bottom: 32px;
  }
  .dash-header h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-weight: 500;
  }
  .dash-header p {
    color: var(--muted);
    font-size: 15px;
    margin-top: 4px;
  }

  .entry-list {
    display: grid;
    gap: 12px;
    margin-bottom: 32px;
  }
  .entry-empty {
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    text-align: center;
  }
  .entry-empty p {
    color: var(--muted);
    font-style: italic;
  }

  .entry-form {
    display: grid;
    gap: 14px;
  }
  .entry-form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .entry-count {
    font-size: 13px;
    color: var(--muted);
  }
</style>
