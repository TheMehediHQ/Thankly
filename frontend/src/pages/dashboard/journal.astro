---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Journal">
  <nav class="dash-nav">
    <div class="container dash-nav-inner">
      <a href="/dashboard" class="dash-logo">🌿 Thankly</a>
      <div class="dash-nav-links">
        <a href="/dashboard/journal" class="active">Journal</a>
        <a href="/dashboard/profile">Profile</a>
        <a href="/admin" id="admin-link" style="display: none;">Admin</a>
        <a href="#" id="logout-btn">Logout</a>
      </div>
    </div>
  </nav>

  <main class="container dash-main">
    <div class="dash-header">
      <div class="dash-header-row">
        <div>
          <h1>Journal History</h1>
          <p>Your complete gratitude journey</p>
        </div>
      </div>
    </div>

    <div class="journal-entries" id="journal-entries">
      <div class="entry-empty"><p>Loading...</p></div>
    </div>
  </main>
</Layout>

<script>
  import { getHistory, logout, isLoggedIn } from '../../lib/api';

  if (!isLoggedIn()) {
    window.location.href = '/login';
  }

  const user = JSON.parse(localStorage.getItem('user') || '{}');
  if (user.role === 'admin' || user.role === 'super_admin') {
    (document.getElementById('admin-link') as HTMLElement).style.display = 'inline';
  }

  const entriesEl = document.getElementById('journal-entries') as HTMLDivElement;
  const logoutBtn = document.getElementById('logout-btn') as HTMLAnchorElement;

  logoutBtn.addEventListener('click', (e) => {
    e.preventDefault();
    logout();
  });

  const emojis = ['☀️', '❤️', '🚀', '🌿', '✨', '🙏', '🌸', '💫'];

  function escapeHtml(text: string) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  async function loadHistory() {
    const data = await getHistory();
    if (!data?.history?.length) {
      entriesEl.innerHTML = '<div class="entry-empty"><p>Your journal entries will appear here.</p></div>';
      return;
    }

    const grouped: Record<string, any[]> = {};
    for (const entry of data.history) {
      const date = entry.gratitude_date;
      if (!grouped[date]) grouped[date] = [];
      grouped[date].push(entry);
    }

    entriesEl.innerHTML = Object.entries(grouped).map(([date, entries]) => {
      const d = new Date(date + 'T00:00:00');
      const formatted = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
      const items = entries.map((e: any, i: number) => `
        <div class="entry-card">
          <span class="entry-emoji">${emojis[i % emojis.length]}</span>
          <span class="entry-text">${escapeHtml(e.content)}</span>
        </div>
      `).join('');
      return `
        <div class="journal-day">
          <div class="journal-date">${formatted}</div>
          ${items}
        </div>
      `;
    }).join('');
  }

  loadHistory();
</script>

<style>
  .dash-nav {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .dash-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }
  .dash-logo {
    font-size: 20px;
    font-weight: 800;
    color: var(--green);
  }
  .dash-nav-links {
    display: flex;
    gap: 24px;
  }
  .dash-nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s;
  }
  .dash-nav-links a:hover,
  .dash-nav-links a.active { color: var(--green); }

  .dash-main {
    padding: 48px 0;
    max-width: 640px;
  }
  .dash-header { margin-bottom: 32px; }
  .dash-header h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-weight: 500;
  }
  .dash-header p {
    color: var(--muted);
    font-size: 15px;
    margin-top: 4px;
  }

  .entry-empty {
    padding: 48px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    text-align: center;
  }
  .entry-empty p { color: var(--muted); }

  .journal-day {
    margin-bottom: 28px;
  }
  .journal-date {
    font-size: 13px;
    font-weight: 700;
    color: var(--green);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }
  .entry-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    margin-bottom: 8px;
  }
  .entry-emoji { font-size: 20px; }
  .entry-text { font-size: 15px; }
</style>
