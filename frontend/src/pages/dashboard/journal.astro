---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Journal">
  <div class="min-h-screen">
    <nav class="border-b border-gray-100 dark:border-gray-800">
      <div class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/dashboard" class="text-xl font-bold text-primary-600">Thankly</a>
        <div class="flex items-center gap-4">
          <a href="/dashboard/journal" class="text-sm text-primary-600 font-medium">Journal</a>
          <a href="/dashboard/profile" class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900">Profile</a>
        </div>
      </div>
    </nav>

    <main class="max-w-3xl mx-auto px-6 py-12">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-2xl font-bold">Journal History</h1>
          <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">Your complete gratitude journey</p>
        </div>
        <div class="flex gap-2">
          <input
            type="date"
            id="date-filter"
            class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm"
          />
        </div>
      </div>

      <!-- Journal Entries -->
      <div class="space-y-8" id="journal-entries">
        <div class="text-center py-12">
          <p class="text-gray-400">Your journal entries will appear here.</p>
        </div>
      </div>
    </main>
  </div>
</Layout>
