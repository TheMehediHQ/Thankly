---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Journal">
  <nav class="dash-nav">
    <div class="container dash-nav-inner">
      <a href="/dashboard" class="dash-logo">🌿 Thankly</a>
      <div class="dash-nav-links">
        <a href="/dashboard/journal" class="active">Journal</a>
        <a href="/dashboard/profile">Profile</a>
      </div>
    </div>
  </nav>

  <main class="container dash-main">
    <div class="dash-header">
      <div class="dash-header-row">
        <div>
          <h1>Journal History</h1>
          <p>Your complete gratitude journey</p>
        </div>
        <input type="date" id="date-filter" class="input" style="width: auto;" />
      </div>
    </div>

    <div class="journal-entries" id="journal-entries">
      <div class="entry-empty">
        <p>Your journal entries will appear here.</p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .dash-nav {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .dash-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }
  .dash-logo {
    font-size: 20px;
    font-weight: 800;
    color: var(--green);
  }
  .dash-nav-links {
    display: flex;
    gap: 24px;
  }
  .dash-nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s;
  }
  .dash-nav-links a:hover,
  .dash-nav-links a.active { color: var(--green); }

  .dash-main {
    padding: 48px 0;
    max-width: 640px;
  }
  .dash-header { margin-bottom: 32px; }
  .dash-header h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-weight: 500;
  }
  .dash-header p {
    color: var(--muted);
    font-size: 15px;
    margin-top: 4px;
  }
  .dash-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .entry-empty {
    padding: 48px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    text-align: center;
  }
  .entry-empty p { color: var(--muted); }
</style>
