---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Profile">
  <nav class="dash-nav">
    <div class="container dash-nav-inner">
      <a href="/dashboard" class="dash-logo">🌿 Thankly</a>
      <div class="dash-nav-links">
        <a href="/dashboard/journal">Journal</a>
        <a href="/dashboard/profile" class="active">Profile</a>
        <a href="/admin" id="admin-link" style="display: none;">Admin</a>
        <a href="#" id="logout-btn">Logout</a>
      </div>
    </div>
  </nav>

  <main class="container dash-main">
    <h1 class="page-title">Profile Settings</h1>

    <div id="error-msg" class="msg-error" style="display: none;"></div>
    <div id="success-msg" class="msg-success" style="display: none;"></div>

    <div class="settings-grid">
      <section class="settings-card">
        <h2>Personal Information</h2>
        <form id="profile-form" class="settings-form">
          <div>
            <label for="name" class="label">Name</label>
            <input type="text" id="name" name="name" class="input" />
          </div>
          <div>
            <label for="email" class="label">Email</label>
            <input type="email" id="email" name="email" disabled class="input" />
          </div>
          <div>
            <label class="label">Role</label>
            <div id="role-display" class="role-badge">—</div>
          </div>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </form>
      </section>

      <section class="settings-card" id="admin-card" style="display: none;">
        <h2>Admin Access</h2>
        <div class="admin-row">
          <div>
            <p class="admin-title">Admin Dashboard</p>
            <p class="admin-desc">Manage users, roles, and view statistics</p>
          </div>
          <a href="/admin" class="btn btn-primary">Open Admin</a>
        </div>
      </section>

      <section class="settings-card">
        <h2>Change Password</h2>
        <form id="password-form" class="settings-form">
          <div>
            <label for="current-password" class="label">Current Password</label>
            <input type="password" id="current-password" class="input" />
          </div>
          <div>
            <label for="new-password" class="label">New Password</label>
            <input type="password" id="new-password" minlength="8" class="input" />
          </div>
          <button type="submit" class="btn btn-primary">Update Password</button>
        </form>
      </section>

      <section class="settings-card">
        <h2>Subscription</h2>
        <div class="subscription-row">
          <div>
            <p class="subscription-plan">Free Plan</p>
            <p class="subscription-desc">3 gratitudes per day</p>
          </div>
          <a href="/" class="btn btn-primary">Upgrade</a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { getProfile, logout, isLoggedIn } from '../../lib/api';

  if (!isLoggedIn()) {
    window.location.href = '/login';
  }

  const user = JSON.parse(localStorage.getItem('user') || '{}');
  if (user.role === 'admin' || user.role === 'super_admin') {
    (document.getElementById('admin-link') as HTMLElement).style.display = 'inline';
  }

  const logoutBtn = document.getElementById('logout-btn') as HTMLAnchorElement;
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const successMsg = document.getElementById('success-msg') as HTMLDivElement;
  const roleDisplay = document.getElementById('role-display') as HTMLDivElement;
  const adminCard = document.getElementById('admin-card') as HTMLElement;

  logoutBtn.addEventListener('click', (e) => {
    e.preventDefault();
    logout();
  });

  function showMsg(el: HTMLDivElement, text: string) {
    el.textContent = text;
    el.style.display = 'block';
    setTimeout(() => { el.style.display = 'none'; }, 3000);
  }

  function formatRole(role: string): string {
    const labels: Record<string, string> = {
      user: 'User',
      admin: 'Admin',
      super_admin: 'Super Admin',
    };
    return labels[role] || role;
  }

  async function loadProfile() {
    const data = await getProfile();
    if (data) {
      (document.getElementById('name') as HTMLInputElement).value = data.name || '';
      (document.getElementById('email') as HTMLInputElement).value = data.email || '';

      const role = data.role || 'user';
      roleDisplay.textContent = formatRole(role);
      roleDisplay.className = `role-badge role-${role}`;

      if (role === 'admin' || role === 'super_admin') {
        adminCard.style.display = 'block';
      }
    }
  }

  const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';

  document.getElementById('profile-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const token = localStorage.getItem('token');

    const res = await fetch(`${API}/api/me`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ name }),
    });

    if (res.ok) {
      showMsg(successMsg, 'Profile updated!');
    } else {
      showMsg(errorMsg, 'Failed to update profile.');
    }
  });

  document.getElementById('password-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const currentPassword = (document.getElementById('current-password') as HTMLInputElement).value;
    const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
    const token = localStorage.getItem('token');

    const res = await fetch(`${API}/api/me/password`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ current_password: currentPassword, new_password: newPassword }),
    });

    if (res.ok) {
      showMsg(successMsg, 'Password changed!');
      (document.getElementById('password-form') as HTMLFormElement).reset();
    } else {
      const data = await res.json();
      showMsg(errorMsg, data.error || 'Failed to change password.');
    }
  });

  loadProfile();
</script>

<style>
  .dash-nav {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .dash-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }
  .dash-logo {
    font-size: 20px;
    font-weight: 800;
    color: var(--green);
  }
  .dash-nav-links {
    display: flex;
    gap: 24px;
  }
  .dash-nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s;
  }
  .dash-nav-links a:hover,
  .dash-nav-links a.active { color: var(--green); }

  .dash-main {
    padding: 48px 0;
    max-width: 640px;
  }
  .page-title {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-weight: 500;
    margin-bottom: 32px;
  }

  .msg-error {
    padding: 12px 16px;
    margin-bottom: 18px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 12px;
    color: #991b1b;
    font-size: 14px;
  }
  .msg-success {
    padding: 12px 16px;
    margin-bottom: 18px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    color: #166534;
    font-size: 14px;
  }

  .settings-grid {
    display: grid;
    gap: 20px;
  }
  .settings-card {
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
  }
  .settings-card h2 {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 18px;
  }
  .settings-form {
    display: grid;
    gap: 16px;
  }

  .role-badge {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 999px;
  }
  .role-user {
    background: #f0f2ee;
    color: #66746d;
  }
  .role-admin {
    background: #e8f5e9;
    color: #2e7d32;
  }
  .role-super_admin {
    background: #fff3e0;
    color: #e65100;
  }

  .admin-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .admin-title {
    font-weight: 600;
    font-size: 15px;
  }
  .admin-desc {
    font-size: 13px;
    color: var(--muted);
    margin-top: 2px;
  }

  .subscription-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .subscription-plan {
    font-weight: 600;
    font-size: 15px;
  }
  .subscription-desc {
    font-size: 13px;
    color: var(--muted);
    margin-top: 2px;
  }
</style>
