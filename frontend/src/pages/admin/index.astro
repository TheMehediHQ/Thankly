---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Dashboard">
  <nav class="dash-nav">
    <div class="container dash-nav-inner">
      <a href="/admin" class="dash-logo">🌿 Thankly <span class="admin-badge">Admin</span></a>
      <div class="dash-nav-links">
        <a href="/dashboard">User Dashboard</a>
        <a href="#" id="logout-btn">Logout</a>
      </div>
    </div>
  </nav>

  <main class="container dash-main">
    <h1 class="page-title">Admin Dashboard</h1>

    <!-- Stats -->
    <div class="stats-grid" id="stats-grid">
      <div class="stat-card">
        <div class="stat-number" id="stat-users">—</div>
        <div class="stat-label">Total Users</div>
      </div>
      <div class="stat-card">
        <div class="stat-number" id="stat-gratitudes">—</div>
        <div class="stat-label">Total Gratitudes</div>
      </div>
      <div class="stat-card">
        <div class="stat-number" id="stat-premium">—</div>
        <div class="stat-label">Premium Users</div>
      </div>
    </div>

    <!-- Users Table -->
    <section class="users-section">
      <h2>All Users</h2>
      <div class="table-wrap">
        <table class="users-table" id="users-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Joined</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="users-tbody">
            <tr><td colspan="5" class="table-loading">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { logout, isLoggedIn } from '../../lib/api';

  if (!isLoggedIn()) {
    window.location.href = '/login';
  }

  const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
  const token = localStorage.getItem('token');
  const user = JSON.parse(localStorage.getItem('user') || '{}');

  if (user.role !== 'admin' && user.role !== 'super_admin') {
    window.location.href = '/dashboard';
  }

  const logoutBtn = document.getElementById('logout-btn') as HTMLAnchorElement;
  logoutBtn.addEventListener('click', (e) => {
    e.preventDefault();
    logout();
  });

  async function api(path: string, options: RequestInit = {}) {
    const res = await fetch(`${API}${path}`, {
      ...options,
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`,
        ...options.headers,
      },
    });
    return res;
  }

  async function loadStats() {
    const res = await api('/api/admin/stats');
    if (res.ok) {
      const data = await res.json();
      (document.getElementById('stat-users') as HTMLElement).textContent = data.total_users;
      (document.getElementById('stat-gratitudes') as HTMLElement).textContent = data.total_gratitudes;
      (document.getElementById('stat-premium') as HTMLElement).textContent = data.premium_users;
    }
  }

  async function loadUsers() {
    const res = await api('/api/admin/users');
    const tbody = document.getElementById('users-tbody') as HTMLTableSectionElement;

    if (!res.ok) {
      tbody.innerHTML = '<tr><td colspan="5" class="table-error">Failed to load users</td></tr>';
      return;
    }

    const data = await res.json();
    if (!data.users?.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="table-empty">No users yet</td></tr>';
      return;
    }

    tbody.innerHTML = data.users.map((u: any) => `
      <tr>
        <td>${escapeHtml(u.name)}</td>
        <td>${escapeHtml(u.email)}</td>
        <td><span class="role-badge role-${u.role}">${u.role}</span></td>
        <td>${new Date(u.created_at).toLocaleDateString()}</td>
        <td class="actions">
          <select class="role-select" data-user-id="${u.id}" data-current="${u.role}">
            <option value="user" ${u.role === 'user' ? 'selected' : ''}>user</option>
            <option value="admin" ${u.role === 'admin' ? 'selected' : ''}>admin</option>
            ${user.role === 'super_admin' ? `<option value="super_admin" ${u.role === 'super_admin' ? 'selected' : ''}>super_admin</option>` : ''}
          </select>
          ${u.id !== user.id ? `<button class="btn-delete" data-user-id="${u.id}">Delete</button>` : '<span class="you-label">You</span>'}
        </td>
      </tr>
    `).join('');

    document.querySelectorAll('.role-select').forEach((sel) => {
      sel.addEventListener('change', async (e) => {
        const target = e.target as HTMLSelectElement;
        const userId = target.dataset.userId;
        const role = target.value;
        const res = await api(`/api/admin/users/${userId}/role`, {
          method: 'PATCH',
          body: JSON.stringify({ role }),
        });
        if (res.ok) {
          loadUsers();
        } else {
          alert('Failed to update role');
          target.value = target.dataset.current;
        }
      });
    });

    document.querySelectorAll('.btn-delete').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.target as HTMLButtonElement;
        if (!confirm('Delete this user?')) return;
        const userId = target.dataset.userId;
        const res = await api(`/api/admin/users/${userId}`, { method: 'DELETE' });
        if (res.ok) {
          loadUsers();
          loadStats();
        } else {
          alert('Failed to delete user');
        }
      });
    });
  }

  function escapeHtml(text: string) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  loadStats();
  loadUsers();
</script>

<style>
  .dash-nav {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .dash-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }
  .dash-logo {
    font-size: 20px;
    font-weight: 800;
    color: var(--green);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .admin-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    background: var(--green);
    color: var(--white);
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .dash-nav-links {
    display: flex;
    gap: 24px;
  }
  .dash-nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s;
  }
  .dash-nav-links a:hover { color: var(--text); }

  .dash-main {
    padding: 48px 0;
    max-width: 900px;
  }
  .page-title {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-weight: 500;
    margin-bottom: 32px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }
  .stat-card {
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    text-align: center;
  }
  .stat-number {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 36px;
    font-weight: 500;
    color: var(--green);
  }
  .stat-label {
    font-size: 13px;
    color: var(--muted);
    margin-top: 4px;
  }

  .users-section h2 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .table-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
  }
  .users-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .users-table th {
    text-align: left;
    padding: 14px 16px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    background: #f5f7f3;
  }
  .users-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }
  .users-table tr:last-child td { border-bottom: 0; }

  .role-badge {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
  }
  .role-user { background: #f0f2ee; color: var(--muted); }
  .role-admin { background: #e8f5e9; color: #2e7d32; }
  .role-super_admin { background: #fff3e0; color: #e65100; }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .role-select {
    padding: 4px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    background: var(--white);
  }
  .btn-delete {
    padding: 4px 10px;
    border: 1px solid #fecaca;
    border-radius: 8px;
    font-size: 12px;
    color: #991b1b;
    background: #fef2f2;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-delete:hover { background: #fee2e2; }
  .you-label {
    font-size: 12px;
    color: var(--muted);
    font-style: italic;
  }

  .table-loading, .table-empty, .table-error {
    text-align: center;
    padding: 32px !important;
    color: var(--muted);
  }
  .table-error { color: #991b1b; }

  @media (max-width: 600px) {
    .stats-grid { grid-template-columns: 1fr; }
    .users-table { font-size: 13px; }
    .users-table th, .users-table td { padding: 10px 12px; }
  }
</style>
