---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Write three things you're grateful for every day. Build a better you, one day at a time.">

  <!-- NAVBAR -->
  <header class="navbar">
    <div class="container nav-inner">
      <a href="#" class="logo">
        <span class="logo-leaf">🌿</span>
        Thankly
      </a>
      <nav class="nav-links">
        <a href="#how-it-works">How it works</a>
        <a href="#pricing">Pricing</a>
        <a href="#about">About</a>
      </nav>
      <div class="nav-actions">
        <a href="/login">Log in</a>
        <a href="#pricing" class="btn btn-primary">Get started</a>
      </div>
    </div>
  </header>

  <!-- HERO -->
  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="eyebrow">
            🌱 A small daily habit
          </div>
          <h1>
            Three things.<br />
            Every day.<br />
            <span>Feel grateful.</span>
          </h1>
          <p class="hero-description">
            Write three things you're grateful for every day
            and build a better you, one day at a time.
          </p>
          <div class="hero-actions">
            <a href="/register" class="btn btn-primary">Start for free</a>
            <a href="#how-it-works" class="btn btn-outline">Learn more</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="features" id="how-it-works">
      <div class="container">
        <div class="feature-grid">
          <article class="feature">
            <div class="feature-icon">☀️</div>
            <h3>Write 3 Daily</h3>
            <p>Focus on the good things happening in your life every day.</p>
          </article>
          <article class="feature">
            <div class="feature-icon">📖</div>
            <h3>All History</h3>
            <p>Keep your complete gratitude journey forever.</p>
          </article>
          <article class="feature">
            <div class="feature-icon">✨</div>
            <h3>Beautiful & Simple</h3>
            <p>A calm space to express yourself without distractions.</p>
          </article>
          <article class="feature">
            <div class="feature-icon">🔒</div>
            <h3>Private & Secure</h3>
            <p>Your journal belongs to you. Your memories stay yours.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- JOURNAL PREVIEW -->
    <section class="section" id="about">
      <div class="container">
        <div class="section-heading">
          <h2>Turn ordinary days into something worth remembering.</h2>
          <p>
            Thankly makes gratitude simple. Write a few words,
            come back tomorrow, and slowly build a journal full
            of moments you're thankful for.
          </p>
        </div>

        <div class="journal-card">
          <div class="journal-main">
            <div class="journal-date">September 1, 2026</div>
            <h3 class="journal-title">Today I'm grateful for...</h3>
            <div class="gratitude-list">
              <div class="gratitude">
                <span class="gratitude-icon">☀️</span>
                <span class="gratitude-text">A peaceful and beautiful morning.</span>
              </div>
              <div class="gratitude">
                <span class="gratitude-icon">❤️</span>
                <span class="gratitude-text">My family's love and support.</span>
              </div>
              <div class="gratitude">
                <span class="gratitude-icon">🚀</span>
                <span class="gratitude-text">Getting closer to my goals every day.</span>
              </div>
            </div>
          </div>

          <aside class="journal-side">
            <div class="streak-number">12</div>
            <div class="streak-label">day gratitude streak 🔥</div>
            <div class="progress"><span></span></div>
            <p style="margin-top: 18px; color: #66746d; font-size: 14px;">
              Keep going. Small moments create meaningful change.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="section pricing" id="pricing">
      <div class="container">
        <div class="section-heading" style="margin-inline: auto; text-align: center;">
          <h2>Simple pricing.</h2>
          <p>
            Start free. Upgrade when you want more from your
            gratitude journey.
          </p>
        </div>

        <div class="pricing-grid">
          <article class="price-card">
            <h3>Free</h3>
            <div class="price">$0<small>/ month</small></div>
            <ul class="price-list">
              <li>3 gratitude entries per day</li>
              <li>Complete journal history</li>
              <li>Basic streak</li>
              <li>Basic statistics</li>
              <li>Standard themes</li>
            </ul>
            <a href="/register" class="btn btn-outline">Get started</a>
          </article>

          <article class="price-card premium">
            <h3>Premium 👑</h3>
            <div class="price">$3<small>/ month</small></div>
            <ul class="price-list">
              <li>Everything in Free</li>
              <li>Advanced insights</li>
              <li>Calendar view</li>
              <li>Export journal</li>
              <li>Custom themes</li>
              <li>Daily reminders</li>
            </ul>
            <a href="/register" class="btn btn-primary">Upgrade to Premium</a>
          </article>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="container">
        <h2>Start noticing the good things.</h2>
        <p>Take a moment today. Write three things you're grateful for.</p>
        <a href="/register" class="btn btn-primary">Start for free →</a>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer>
    <div class="container footer-inner">
      <div>© 2026 Thankly. All rights reserved.</div>
      <div>Three things. Every day. Feel grateful. 🌿</div>
    </div>
  </footer>

</Layout>

<style>
  :root {
    --bg: #f8f6ef;
    --surface: #fffdf8;
    --text: #17382b;
    --muted: #66746d;
    --green: #2f7656;
    --green-dark: #225b42;
    --border: #dfe5dc;
    --white: #ffffff;
    --radius: 18px;
    --max-width: 1180px;
  }

  a { color: inherit; text-decoration: none; }
  button { font: inherit; cursor: pointer; }

  .container {
    width: min(calc(100% - 40px), var(--max-width));
    margin-inline: auto;
  }

  /* NAVBAR */
  .navbar {
    position: absolute;
    z-index: 10;
    top: 0; left: 0; right: 0;
    padding: 24px 0;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .logo-leaf { font-size: 23px; }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    font-size: 14px;
    font-weight: 500;
  }
  .nav-links a { transition: opacity 0.2s ease; }
  .nav-links a:hover { opacity: 0.6; }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 14px;
    font-weight: 600;
  }

  /* BUTTONS */
  .btn {
    border: 0;
    border-radius: 999px;
    padding: 12px 20px;
    font-weight: 700;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    display: inline-block;
    text-align: center;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn-primary {
    color: var(--white);
    background: var(--green);
    box-shadow: 0 8px 24px rgba(47, 118, 86, 0.18);
  }
  .btn-primary:hover { background: var(--green-dark); }
  .btn-outline {
    color: var(--text);
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--border);
  }

  /* HERO */
  .hero {
    min-height: 760px;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(248,246,239,0.97) 0%, rgba(248,246,239,0.90) 30%, rgba(248,246,239,0.35) 60%, rgba(248,246,239,0.05) 100%),
      url("/hero.png") center / cover no-repeat;
  }
  .hero-content { width: 52%; padding-top: 50px; }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    padding: 7px 13px;
    border-radius: 999px;
    background: rgba(255,255,255,0.72);
    border: 1px solid rgba(223,229,220,0.9);
    color: var(--green-dark);
    font-size: 13px;
    font-weight: 700;
  }
  .hero h1 {
    max-width: 650px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(54px, 7vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 500;
  }
  .hero h1 span { color: var(--green); font-style: italic; }
  .hero-description {
    max-width: 500px;
    margin-top: 28px;
    color: #52615a;
    font-size: 18px;
    line-height: 1.7;
  }
  .hero-actions { display: flex; gap: 12px; margin-top: 32px; }

  /* FEATURES */
  .features { position: relative; z-index: 2; margin-top: -70px; }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
    background: rgba(255,253,248,0.94);
    border: 1px solid var(--border);
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(39,65,51,0.08);
    backdrop-filter: blur(12px);
  }
  .feature { padding: 30px; border-right: 1px solid var(--border); }
  .feature:last-child { border-right: 0; }
  .feature-icon {
    width: 42px; height: 42px;
    display: grid; place-items: center;
    margin-bottom: 18px;
    border-radius: 13px;
    background: #edf5ec;
    font-size: 20px;
  }
  .feature h3 { margin-bottom: 7px; font-size: 16px; }
  .feature p { color: var(--muted); font-size: 14px; line-height: 1.6; }

  /* SECTIONS */
  .section { padding: 120px 0; }
  .section-heading { max-width: 650px; margin-bottom: 50px; }
  .section-heading h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(40px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  .section-heading p { margin-top: 16px; color: var(--muted); }

  /* JOURNAL CARD */
  .journal-card {
    display: grid;
    grid-template-columns: 1fr 360px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 26px;
  }
  .journal-main { padding: 48px; }
  .journal-date {
    color: var(--green);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .journal-title {
    margin-top: 10px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 38px;
  }
  .gratitude-list { display: grid; gap: 14px; margin-top: 30px; }
  .gratitude {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 19px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: #fffefa;
  }
  .gratitude-icon { font-size: 22px; }
  .gratitude-text { font-size: 15px; }
  .journal-side {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px;
    background: #edf4eb;
  }
  .streak-number {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 60px;
    line-height: 1;
  }
  .streak-label { margin-top: 8px; color: var(--muted); font-size: 14px; }
  .progress {
    height: 8px;
    margin-top: 25px;
    overflow: hidden;
    border-radius: 999px;
    background: #d7e2d5;
  }
  .progress span {
    display: block;
    width: 82%;
    height: 100%;
    border-radius: inherit;
    background: var(--green);
  }

  /* PRICING */
  .pricing { background: #eef3eb; }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 850px;
    margin: 0 auto;
  }
  .price-card {
    padding: 36px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
  }
  .price-card.premium { border: 2px solid var(--green); }
  .price-card h3 { font-size: 21px; }
  .price {
    margin-top: 15px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 48px;
  }
  .price small { font-family: Inter, sans-serif; color: var(--muted); font-size: 14px; }
  .price-list {
    display: grid;
    gap: 12px;
    margin: 28px 0;
    list-style: none;
    color: var(--muted);
    font-size: 14px;
  }
  .price-list li::before {
    content: "✓";
    margin-right: 9px;
    color: var(--green);
    font-weight: 800;
  }
  .price-card .btn { width: 100%; }

  /* CTA */
  .cta { padding: 110px 0; text-align: center; }
  .cta h2 {
    max-width: 700px;
    margin: 0 auto;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 5vw, 64px);
    line-height: 1.05;
    font-weight: 500;
  }
  .cta p { max-width: 520px; margin: 20px auto 30px; color: var(--muted); }

  /* FOOTER */
  footer { padding: 30px 0; border-top: 1px solid var(--border); }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    font-size: 13px;
  }

  /* MOBILE */
  @media (max-width: 900px) {
    .nav-links { display: none; }
    .hero { min-height: 720px; background-position: 62% center; }
    .hero-content { width: 72%; }
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
    .feature:nth-child(2) { border-right: 0; }
    .feature:nth-child(-n + 2) { border-bottom: 1px solid var(--border); }
    .journal-card { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .container { width: min(calc(100% - 28px), var(--max-width)); }
    .navbar { padding: 17px 0; }
    .nav-actions a:first-child { display: none; }
    .hero {
      min-height: 680px;
      align-items: flex-end;
      padding-bottom: 80px;
      background:
        linear-gradient(180deg, rgba(248,246,239,0.1) 10%, rgba(248,246,239,0.78) 55%, rgba(248,246,239,0.98) 88%),
        url("/hero.png") 62% center / cover no-repeat;
    }
    .hero-content { width: 100%; padding: 0; }
    .hero h1 { font-size: 55px; }
    .hero-description { font-size: 16px; }
    .hero-actions { flex-direction: column; }
    .hero-actions .btn { width: 100%; }
    .features { margin-top: -30px; }
    .feature-grid { grid-template-columns: 1fr; }
    .feature { border-right: 0; border-bottom: 1px solid var(--border); }
    .feature:last-child { border-bottom: 0; }
    .section { padding: 80px 0; }
    .journal-main { padding: 28px; }
    .journal-side { padding: 30px; }
    .pricing-grid { grid-template-columns: 1fr; }
    .footer-inner { flex-direction: column; gap: 8px; }
  }
</style>
