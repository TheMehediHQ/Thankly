---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <!-- Navigation -->
  <nav class="fixed top-0 w-full bg-white/80 dark:bg-gray-950/80 backdrop-blur-md z-50 border-b border-gray-100 dark:border-gray-800">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="text-2xl font-bold text-primary-600">Thankly</a>
      <div class="flex items-center gap-6">
        <a href="/pricing" class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100">Pricing</a>
        <a href="/login" class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100">Login</a>
        <a href="/register" class="text-sm px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition">Get Started</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="pt-32 pb-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-bold leading-tight mb-6">
        Build a better mindset,<br />
        <span class="text-primary-600">one day at a time</span>
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-10 max-w-2xl mx-auto">
        Write 3 things you're grateful for every day. Simple, private, and beautiful. Your personal gratitude journal.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a href="/register" class="px-8 py-3 bg-primary-600 text-white rounded-xl text-lg font-medium hover:bg-primary-700 transition shadow-lg shadow-primary-600/25">
          Start Free
        </a>
        <a href="/pricing" class="px-8 py-3 border border-gray-200 dark:border-gray-700 rounded-xl text-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-900 transition">
          View Pricing
        </a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 px-6 bg-gray-50 dark:bg-gray-900/50">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12">Simple by design</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-6 bg-white dark:bg-gray-800 rounded-2xl shadow-sm">
          <div class="text-3xl mb-4">☀️</div>
          <h3 class="text-lg font-semibold mb-2">3 Gratitudes Daily</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm">Write up to 3 things you're grateful for each day. Simple, focused, meaningful.</p>
        </div>
        <div class="p-6 bg-white dark:bg-gray-800 rounded-2xl shadow-sm">
          <div class="text-3xl mb-4">📖</div>
          <h3 class="text-lg font-semibold mb-2">Complete History</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm">Access your entire gratitude journal from day one. Browse, search, and reflect.</p>
        </div>
        <div class="p-6 bg-white dark:bg-gray-800 rounded-2xl shadow-sm">
          <div class="text-3xl mb-4">🔒</div>
          <h3 class="text-lg font-semibold mb-2">Private & Secure</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm">Your journal is yours alone. End-to-end privacy with secure authentication.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">Start your gratitude journey today</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-8">Join Thankly and discover the power of daily gratitude.</p>
      <a href="/register" class="inline-block px-8 py-3 bg-primary-600 text-white rounded-xl text-lg font-medium hover:bg-primary-700 transition">
        Create Free Account
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-gray-100 dark:border-gray-800 py-8 px-6">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <span class="text-sm text-gray-500">© 2026 Thankly. All rights reserved.</span>
      <div class="flex gap-4">
        <a href="/privacy" class="text-sm text-gray-500 hover:text-gray-700">Privacy</a>
        <a href="/terms" class="text-sm text-gray-500 hover:text-gray-700">Terms</a>
      </div>
    </div>
  </footer>
</Layout>
