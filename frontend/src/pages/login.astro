---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Login">
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-header">
        <a href="/" class="auth-logo">🌿 Thankly</a>
        <h1>Welcome back</h1>
        <p>Sign in to your gratitude journal</p>
      </div>

      <div id="error-msg" class="auth-error" style="display: none;"></div>

      <form id="login-form" class="auth-form">
        <div>
          <label for="email" class="label">Email</label>
          <input type="email" id="email" name="email" required class="input" placeholder="you@example.com" />
        </div>
        <div>
          <label for="password" class="label">Password</label>
          <input type="password" id="password" name="password" required class="input" placeholder="••••••••" />
        </div>
        <button type="submit" id="submit-btn" class="btn btn-primary" style="width: 100%;">Sign In</button>
      </form>

      <p class="auth-footer">
        Don't have an account? <a href="/register">Sign up</a>
      </p>
    </div>
  </div>
</Layout>

<script>
  import { login } from '../lib/api';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.style.display = 'none';
    submitBtn.textContent = 'Signing in...';
    submitBtn.style.opacity = '0.6';

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    const result = await login(email, password);

    if (result?.ok) {
      window.location.href = '/dashboard';
    } else {
      errorMsg.textContent = result?.data?.error || 'Login failed. Please try again.';
      errorMsg.style.display = 'block';
      submitBtn.textContent = 'Sign In';
      submitBtn.style.opacity = '1';
    }
  });
</script>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .auth-card {
    width: 100%;
    max-width: 420px;
    padding: 40px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
  }
  .auth-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .auth-logo {
    font-size: 24px;
    font-weight: 800;
    color: var(--green);
  }
  .auth-header h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 28px;
    font-weight: 500;
    margin-top: 16px;
  }
  .auth-header p {
    color: var(--muted);
    margin-top: 8px;
    font-size: 15px;
  }
  .auth-form {
    display: grid;
    gap: 18px;
  }
  .auth-error {
    padding: 12px 16px;
    margin-bottom: 18px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 12px;
    color: #991b1b;
    font-size: 14px;
  }
  .auth-footer {
    text-align: center;
    font-size: 14px;
    color: var(--muted);
    margin-top: 24px;
  }
  .auth-footer a {
    color: var(--green);
    font-weight: 600;
  }
  .auth-footer a:hover { text-decoration: underline; }
</style>
